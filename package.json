{
  "name": "mi-casa",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:emulator": "node scripts/auth-web.mjs",
    "dev:auth-test": "node scripts/auth-web.mjs auth-test",
    "firebase:auth:seed": "npm run build:server && node functions/scripts/seed-auth.mjs",
    "test:auth:emulator": "npm run build:server && node tests/firebase-auth/run.mjs",
    "test:inventory:emulator": "npm run build:server && node tests/firebase-inventory/run.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "firebase:lab:start": "node tests/firebase-lab/run.mjs start",
    "test:firebase:emulator": "node tests/firebase-lab/run.mjs test",
    "test:firebase:unit": "node --test tests/firebase-lab/model.test.mjs",
    "test:firebase:rules-check": "node tests/firebase-lab/generate-rules.mjs --check",
    "test:firebase:measure": "node tests/firebase-lab/measure.mjs",
    "test:firebase:browser": "playwright test --config tests/firebase-lab/playwright.config.mjs",
    "firebase:trusted:start": "node tests/firebase-trusted/run.mjs start",
    "test:firebase:trusted": "node tests/firebase-trusted/run.mjs test",
    "test:firebase:trusted:unit": "node --test tests/firebase-trusted/contract.test.mjs",
    "test:firebase:trusted:browser": "playwright test --config tests/firebase-trusted/playwright.config.mjs",
    "typecheck:server": "npm --prefix functions run typecheck",
    "build:server": "npm --prefix functions run build",
    "test:server": "npm --prefix functions test",
    "test:firebase:local": "npm --prefix functions run test:emulator",
    "firebase:local:start": "npm --prefix functions run emulators"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.6"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "firebase-admin": "13.10.0",
    "firebase-functions": "7.4.0",
    "firebase-tools": "15.37.0",
    "jsdom": "27.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
