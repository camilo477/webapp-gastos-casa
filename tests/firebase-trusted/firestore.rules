rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == 'demo-owner-04c' && request.auth.uid == uid;
    }
    match /users/{uid}/products/{id} { allow read: if owner(uid); allow write: if false; }
    match /users/{uid}/operations/{id} { allow read: if owner(uid); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
