# Public fictitious values only. Demo is the default; dev:emulator opts into local Auth.
VITE_APP_MODE=demo
VITE_FIREBASE_PROJECT_ID=demo-mi-casa-05a
VITE_AUTH_EMULATOR_HOST=127.0.0.1:9299
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8386
VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5205
# Server variables are supplied by the checked local runner, not Vite or this file.
# No staging/production values, private keys, tokens or real user identities.

# FUTURE AUTH-ONLY TEST PROJECT. Disabled: no approval and no usable SDK values.
# Do not combine these with emulator endpoints. See FIREBASE_IMPLEMENTATION_GUIDE.md.
# Only after the owner explicitly authorizes the project and provider(s):
# VITE_APP_MODE=auth-test
# VITE_FIREBASE_PROJECT_ID=example-auth-test
# VITE_FIREBASE_API_KEY=example-public-web-key-not-valid
# VITE_FIREBASE_AUTH_DOMAIN=example-auth-test.firebaseapp.com
# VITE_FIREBASE_APP_ID=1:1234567890:web:0123456789abcdef
# VITE_AUTH_TEST_OWNER_UID=REPLACE_WITH_AUTHORIZED_UID
# VITE_AUTH_TEST_PROVIDERS=google
# VITE_AUTH_TEST_GOOGLE_FLOW=popup
# VITE_AUTH_TEST_ORIGIN=http://localhost:5175
# VITE_AUTH_TEST_APPROVAL=  (leave empty until owner approves; exact binding in the guide)

# FIRESTORE READ-ONLY, explicitly authorized in 05C-6. Disabled by default.
# dev:auth-test always keeps Auth-only. dev:inventory-read explicitly selects the reader
# and loads VITE_FIRESTORE_READ_* from .env.inventory-read.local; reuses private Auth config.
# No real UID in this file. Project-bound approval and server rules/ACL remain required.
# VITE_FIRESTORE_READ_ENABLED=false
# VITE_FIRESTORE_READ_DATABASE=(default)
# VITE_FIRESTORE_READ_CONTRACT=inventory-candidate-v1
# VITE_FIRESTORE_READ_APPROVAL=  (project-bound read-only approval; never Auth-only approval)

# Emulator-only inventory candidate is now the default. No migration or real connection.
# VITE_INVENTORY_CONTRACT=inventory-candidate-v1
# Historical regression only: dev:emulator:legacy selects experimental-05c1 explicitly.
