rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Local fixture only. A real UID and policy require later authorization.
    function localOwner(uid) {
      return request.auth != null && request.auth.uid == 'demo-owner-05a' && request.auth.uid == uid;
    }
    match /users/{uid}/products/{id} { allow read: if localOwner(uid); allow write: if false; }
    match /users/{uid}/operations/{id} { allow read: if localOwner(uid); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
