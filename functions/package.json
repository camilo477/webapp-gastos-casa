{
  "name": "mi-casa-local-executor",
  "version": "0.0.0-experimental.05a",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": { "node": "24" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test tests/unit.test.mjs tests/inventory-unit.test.mjs",
    "emulators": "npm run build && node scripts/emulators.mjs start",
    "test:emulator": "npm run build && node scripts/emulators.mjs test"
  },
  "dependencies": {
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0"
  },
  "overrides": {
    "@firebase/firestore": { "@grpc/grpc-js": "1.14.7" }
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "24.19.2",
    "firebase": "13.4.0",
    "firebase-tools": "15.37.0",
    "typescript": "6.0.3"
  }
}
